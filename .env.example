# Copy to .env and fill in. The real .env is gitignored; never commit secrets.

# Local DuckDB file (relative to the repo root)
MARKET_INTEL_DB_PATH=data/market_intel.duckdb

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# Example: "market-intel your.name@example.com"
SEC_USER_AGENT=

# Claude API: writes the digest's analysis. Create a key at https://platform.claude.com
# (Settings > API keys). Without it the digest uses rule-based notes instead.
ANTHROPIC_API_KEY=

# News / earnings calendar
FINNHUB_API_KEY=

# Macro data
FRED_API_KEY=

# Delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
